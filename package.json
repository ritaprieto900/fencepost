{
  "name": "fencepost",
  "version": "0.0.3",
  "description": "Leases with fencing tokens for agents sharing one working tree. Windows-safe, no daemon.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
